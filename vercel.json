{
  "version": 2,
  "builds": [
    {
      "src": "backend/main.py",
      "use": "@vercel/python"
    }
  ],
  "rewrites": [
    {
      "source": "/static/(.*)",
      "destination": "backend/static/$1"
    },
    {
      "source": "/(.*)",
      "destination": "backend/main.py"
    }
  ],
  "env": {
    "PYTHONPATH": "backend"
  }
}
