{
  "version": 2,
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/index.py"
    }
  ],
  "env": {
    "PYTHONPATH": "."
  },
  "functions": {
    "api/index.py": {
      "maxDuration": 60,
      "excludeFiles": "{Vault/**,deploy_temp/**,backend/venv/**,backend/scratch/**,Contexto.docx,Final.jpg,implementation_plan.md,**/*.wav,**/*.mp3,**/*.mp4,**/*.mov,**/*.m4a}"
    }
  }
}
